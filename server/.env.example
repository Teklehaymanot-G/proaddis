# ---- Database (MySQL / MariaDB) ----
# Tables are created automatically on first start.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=proaddis_marketing

# ---- First admin account ----
# Only used on the very first start, when there are no users yet.
# If ADMIN_PASSWORD is empty a random one is printed in the server log.
ADMIN_EMAIL=admin@proaddismarketing.com
ADMIN_PASSWORD=admin@123

# ---- Security ----
# Signs sessions and encrypts the saved SMTP password. Use a long random
# value and keep it the same forever. Empty: one is generated in data/.
APP_SECRET=

# ---- Email fallback ----
# Used until SMTP is saved in the admin under Settings > Email (SMTP).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
CONTACT_EMAIL=

PORT=5000
NODE_ENV=production
