# Where the API server (../server) is reachable
VITE_API_URL=http://localhost:5000

# The public website, for the "View website" link
VITE_SITE_URL=http://localhost:5173

# Path the admin is served from: "/" for its own domain (admin.example.com),
# or "/admin/" when it lives in a folder of the main site.
VITE_BASE=/
